# expo-alt :: configuration template
# Copy this file to `.env` and fill in your values:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux/macOS)
#
# `.env` is gitignored - your values never get committed.
#
# Who reads this file:
#   - local/toast.ps1 (your PC): uses VPS_SSH_USER + VPS_IP_OR_DOMAIN
#     (or VPS_SSH_ALIAS) to know which server to ssh into
#   - vps/setup-kitchen.sh (VPS): if you copy your .env to the repo root on
#     the VPS, it prefills GITHUB_USER and BUILD_URL_BASE into the server
#     config (optional - it prompts for anything missing anyway)
#   - you: single place of truth for all your personal values

# ---------------------------------------------------------------- required

# GitHub account or org that owns your app repos.
# `cook myapp` builds git@github.com:$GITHUB_USER/myapp.git
# (`cook owner/name` overrides this per build)
GITHUB_USER=""

# Public IP or domain of your VPS, e.g. 203.0.113.7 or builds.example.com
VPS_IP_OR_DOMAIN=""

# Linux user you SSH into on the VPS, e.g. root or deploy
VPS_SSH_USER=""

# Public base URL for APK downloads, NO trailing slash.
# Usually http://<VPS_IP_OR_DOMAIN>, or https://<domain> if you set up TLS.
BUILD_URL_BASE=""

# ---------------------------------------------------------------- optional

# If set, toast.ps1 uses `ssh <this alias>` instead of building
# VPS_SSH_USER@VPS_IP_OR_DOMAIN. The alias must exist as a `Host` entry in
# your ~/.ssh/config (useful for a non-default key or port).
VPS_SSH_ALIAS=""

# Name of your main app repo (used only as an example in docs/tests)
APP_REPO=""

# URL of your fork/copy of this expo-alt repo, once it lives on GitHub
# (e.g. git@github.com:<you>/expo-alt.git)
EXPO_ALT_REPO_URL=""

# Cleaning policies on the VPS (defaults shown; uncomment to override).
# Quick pass (after every build): APKs, logs, tmp. Full pass (weekly cron,
# or run `kitchen-clean` manually; `--dry-run` previews): also idle repos'
# node_modules, stale working copies, gradle cache cap.
#RETENTION_DAYS=14              # delete build dirs older than this
#MAX_BUILDS=20                  # keep at most this many build dirs
#LOG_RETENTION_DAYS=60          # delete logs older than this
#TMP_RETENTION_HOURS=24         # delete tmp/ entries older than this
#NODE_MODULES_RETENTION_DAYS=7  # drop node_modules of repos idle this long
#REPO_RETENTION_DAYS=30         # delete whole working copies idle this long
#GRADLE_CACHE_MAX_GB=10         # wipe gradle cache if it grows past this

# Burn-after-download (kitchen-burn, runs every minute on the VPS):
# a build's first COMPLETE download (bytes served reach the APK size) starts
# a timer; when it expires, the APK dir, the repo working copy and that
# build's log are all deleted. Slow/paused downloads don't start it early.
#BURN_AFTER_DOWNLOAD=1          # set 0 to disable
#DOWNLOAD_TTL_MINUTES=30        # minutes between complete download and burn

# ---------------------------------------------------------------- secret
# EXPO_TOKEN - your Expo access token, from:
#   expo.dev -> Account settings -> Access tokens
# LEAVE THIS EMPTY IN YOUR PC's COPY. It is used only by the VPS copy of
# this file (e.g. /var/www/expo-alt/.env): setup-kitchen.sh fills it in
# there when it prompts you (hidden input), or you can paste it there
# manually. The VPS file is chmod 600, gitignored and never web-served.
EXPO_TOKEN=""
