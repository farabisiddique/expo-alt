# expo-alt :: configuration template
# Copy this file to `.env` and fill in your values:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux/macOS)
#
# `.env` is gitignored - your values never get committed.
#
# Who reads this file:
#   - local/toast.ps1 (your PC): uses VPS_SSH_USER + VPS_IP_OR_DOMAIN
#     (or VPS_SSH_ALIAS) to know which server to ssh into
#   - vps/setup-kitchen.sh (VPS): if you copy your .env to the repo root on
#     the VPS, it prefills GITHUB_USER and BUILD_URL_BASE into the server
#     config (optional - it prompts for anything missing anyway)
#   - you: single place of truth for all your personal values

# ---------------------------------------------------------------- required

# GitHub account or org that owns your app repos.
# `cook myapp` builds git@github.com:$GITHUB_USER/myapp.git
# (`cook owner/name` overrides this per build)
GITHUB_USER=""

# Public IP or domain of your VPS, e.g. 203.0.113.7 or builds.example.com
VPS_IP_OR_DOMAIN=""

# Linux user you SSH into on the VPS, e.g. root or deploy
VPS_SSH_USER=""

# Public base URL for APK downloads, NO trailing slash.
# Usually http://<VPS_IP_OR_DOMAIN>, or https://<domain> if you set up TLS.
BUILD_URL_BASE=""

# ---------------------------------------------------------------- optional

# If set, toast.ps1 uses `ssh <this alias>` instead of building
# VPS_SSH_USER@VPS_IP_OR_DOMAIN. The alias must exist as a `Host` entry in
# your ~/.ssh/config (useful for a non-default key or port).
VPS_SSH_ALIAS=""

# Name of your main app repo (used only as an example in docs/tests)
APP_REPO=""

# URL of your fork/copy of this expo-alt repo, once it lives on GitHub
# (e.g. git@github.com:<you>/expo-alt.git)
EXPO_ALT_REPO_URL=""

# ---------------------------------------------------------------- secrets
# EXPO_TOKEN does NOT go in this file. Enter it directly on the VPS when
# setup-kitchen.sh prompts for it (hidden input); it lives only in
# ~/.config/expo-alt/env there, chmod 600. Keep secrets out of project dirs.
