#!/usr/bin/env bash
#
# expo-alt :: cook - build an Expo Android APK locally on this VPS.
#
# Usage:
#   cook <repo> [profile] [git-ref] [--no-check]
#
#     repo        "name"       -> git@github.com:$GITHUB_USER/name.git
#                 "owner/name" -> git@github.com:owner/name.git
#                 (owner/name form is for repos you collaborate on; your VPS
#                 SSH key must have GitHub access to them, and your Expo
#                 account must have access to the project's credentials)
#     profile     eas.json build profile (default: preview)
#     git-ref     branch, tag or commit SHA (default: main)
#     --no-check  skip the `tsc --noEmit` quality gate
#
# Fully self-contained: every directory this script creates (work copies,
# logs, locks, builds, caches, temp) lives inside the expo-alt directory the
# script belongs to (e.g. /var/www/expo-alt). Config comes from the .env at
# that directory's root. Streams all output to stdout AND to
# kitchen/logs/<owner>--<repo>-<UTCtimestamp>.log. On success the last line
# of both is "DOWNLOAD: <url>".
#
# Install (done by setup-kitchen.sh): a SYMLINK, so `git pull` updates cook
# with no reinstall step and the script can locate its own directory:
#     ln -sfn /var/www/expo-alt/vps/cook /usr/local/bin/cook
#
set -euo pipefail

usage() { sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; }

die() { printf 'cook: ERROR: %s\n' "$*" >&2; exit 1; }

# ------------------------------------------------------------------ self-location
# ROOT = the expo-alt directory. readlink -f resolves the /usr/local/bin
# symlink to this real file, so ROOT is correct wherever the repo lives.

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
[ -f "$ROOT/vps/cook" ] || die "cannot locate the expo-alt dir from $SELF (install cook as a SYMLINK, not a copy)"

# ------------------------------------------------------------------ arguments

NO_CHECK=0
POS=()
for arg in "$@"; do
  case "$arg" in
    --no-check) NO_CHECK=1 ;;
    -h|--help)  usage; exit 0 ;;
    -*)         die "unknown flag: $arg (see cook --help)" ;;
    *)          POS+=("$arg") ;;
  esac
done
REPO="${POS[0]:-}"
PROFILE="${POS[1]:-preview}"
REF="${POS[2]:-main}"
[ -n "$REPO" ] || { usage; exit 1; }
# Accept "name" (owned by $GITHUB_USER) or "owner/name" (e.g. a friend's repo
# you collaborate on). Anything else is rejected.
case "$REPO" in
  *..*|/*|*/|*/*/*|.*) die "invalid repo: $REPO (use 'name' or 'owner/name')" ;;
esac

# ------------------------------------------------------------------ environment
# All toolchain paths and caches are contained inside $ROOT. Nothing outside
# it is written to (system packages, nginx config and ~/.ssh excepted).

export ANDROID_HOME="${ANDROID_HOME:-$ROOT/sdk/android}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$ROOT/cache/gradle}"
export npm_config_cache="${npm_config_cache:-$ROOT/cache/npm}"
export YARN_CACHE_FOLDER="${YARN_CACHE_FOLDER:-$ROOT/cache/yarn}"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools"
if [ -z "${JAVA_HOME:-}" ] && command -v javac >/dev/null 2>&1; then
  JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"
  export JAVA_HOME
fi

# Even eas-cli's temporary build workdir stays inside $ROOT/tmp.
TMP_DIR="$ROOT/tmp"
mkdir -p "$TMP_DIR"
EAS_WORKDIR="$TMP_DIR/eas-work-$$"
export EAS_LOCAL_BUILD_WORKINGDIR="$EAS_WORKDIR"

ENV_FILE="$ROOT/.env"
if [ ! -f "$ENV_FILE" ] && [ -f "$HOME/.config/expo-alt/env" ]; then
  ENV_FILE="$HOME/.config/expo-alt/env"   # legacy location fallback
fi
[ -f "$ENV_FILE" ] || die "config file missing: $ROOT/.env (run setup-kitchen.sh)"
# Export everything defined in the env file (EXPO_TOKEN must reach eas-cli).
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a

[ -n "${GITHUB_USER:-}" ]    || die "GITHUB_USER is not set in $ENV_FILE"
[ -n "${BUILD_URL_BASE:-}" ] || die "BUILD_URL_BASE is not set in $ENV_FILE"
if [ -z "${EXPO_TOKEN:-}" ]; then
  die "EXPO_TOKEN is not set in $ENV_FILE - create one at expo.dev -> Account settings -> Access tokens"
fi

# Resolve "name" vs "owner/name" (the latter for repos you collaborate on).
if [ "${REPO#*/}" != "$REPO" ]; then
  REPO_OWNER="${REPO%%/*}"
  REPO_NAME="${REPO#*/}"
else
  REPO_OWNER="$GITHUB_USER"
  REPO_NAME="$REPO"
fi
{ [ -n "$REPO_OWNER" ] && [ -n "$REPO_NAME" ]; } || die "invalid repo: $REPO"
# Filesystem-safe id used for the lock, log and working-copy directory names,
# so owner/name repos can't collide with your own repo of the same name.
REPO_SLUG="${REPO_OWNER}--${REPO_NAME}"

BUILDS_DIR="$ROOT/builds"

# ------------------------------------------------------------------ locking
# One cook per repo at a time. fd 9 is opened in APPEND mode first so a failed
# lock attempt does not truncate the holder info written by the running build.

LOCK_DIR="$ROOT/kitchen/locks"
mkdir -p "$LOCK_DIR"
LOCKFILE="$LOCK_DIR/$REPO_SLUG.lock"
exec 9>>"$LOCKFILE"
if ! flock -n 9; then
  printf 'cook: another build of "%s" is already running:\n' "$REPO" >&2
  sed 's/^/  /' "$LOCKFILE" >&2 || true
  printf 'cook: refusing to start. (The lock is released automatically when that build exits.)\n' >&2
  exit 1
fi
printf 'pid=%s user=%s host=%s started=%sZ\n' \
  "$$" "$(id -un)" "$(hostname)" "$(date -u +%Y-%m-%dT%H:%M:%S)" > "$LOCKFILE"

# ------------------------------------------------------------------ logging

LOG_DIR="$ROOT/kitchen/logs"
mkdir -p "$LOG_DIR"
STAMP="$(date -u +%Y%m%d-%H%M%S)"
LOG="$LOG_DIR/$REPO_SLUG-$STAMP.log"
# Everything from here on goes to the terminal AND the log file.
exec > >(tee -- "$LOG") 2>&1

START_EPOCH="$(date +%s)"
elapsed() {
  local s=$(( $(date +%s) - START_EPOCH ))
  printf '%dm %02ds' $((s / 60)) $((s % 60))
}

on_exit() {
  local status=$?
  if [ -n "${EAS_WORKDIR:-}" ]; then rm -rf "$EAS_WORKDIR" 2>/dev/null || true; fi
  if [ "$status" -ne 0 ]; then
    rm -f "${TMP_APK:-}" 2>/dev/null || true
    printf '\n==========================================================\n'
    printf '  BUILD FAILED (exit %s) after %s\n' "$status" "$(elapsed)"
    printf '  full log : %s\n' "$LOG"
    printf '==========================================================\n'
  fi
}
trap on_exit EXIT

# ------------------------------------------------------------------ fetch source

REPO_DIR="$ROOT/kitchen/repos/$REPO_SLUG"
REPO_URL="git@github.com:$REPO_OWNER/$REPO_NAME.git"

if [ ! -d "$REPO_DIR/.git" ]; then
  echo "==> Cloning $REPO_URL"
  git clone --quiet "$REPO_URL" "$REPO_DIR"
fi
cd "$REPO_DIR"
git remote set-url origin "$REPO_URL"

echo "==> Fetching origin"
git fetch --quiet --tags --prune origin

if git rev-parse --verify -q "refs/remotes/origin/$REF" >/dev/null; then
  TARGET="origin/$REF"
elif git rev-parse --verify -q "$REF^{commit}" >/dev/null; then
  TARGET="$REF"
else
  die "ref '$REF' not found in $REPO (neither a remote branch nor a commit/tag)"
fi

# The kitchen copy is disposable: force-checkout the target and wipe anything
# that is not tracked (node_modules is re-created by the install step anyway).
git checkout --quiet --force --detach "$TARGET"
git clean -ffdxq

SHA="$(git rev-parse --short HEAD)"
COMMIT_MSG="$(git log -1 --pretty=%s)"

printf '\n==========================================================\n'
printf '  expo-alt :: cook\n'
printf '  repo    : %s/%s\n' "$REPO_OWNER" "$REPO_NAME"
printf '  ref     : %s (%s)\n' "$REF" "$SHA"
printf '  commit  : %s\n' "$COMMIT_MSG"
printf '  profile : %s\n' "$PROFILE"
printf '  started : %s UTC\n' "$(date -u '+%Y-%m-%d %H:%M:%S')"
printf '  log     : %s\n' "$LOG"
printf '==========================================================\n\n'

# ------------------------------------------------------------------ install deps

if [ -f yarn.lock ]; then
  PM="yarn"
elif [ -f pnpm-lock.yaml ]; then
  PM="pnpm"
else
  PM="npm"
fi
echo "==> Installing dependencies ($PM, frozen lockfile)"
case "$PM" in
  yarn)
    command -v yarn >/dev/null 2>&1 || corepack enable >/dev/null 2>&1 || true
    yarn install --frozen-lockfile
    ;;
  pnpm)
    command -v pnpm >/dev/null 2>&1 || corepack enable >/dev/null 2>&1 || true
    pnpm install --frozen-lockfile
    ;;
  npm)
    if [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then
      npm ci --no-audit --no-fund
    else
      echo "    NOTE: no package-lock.json in this repo - falling back to 'npm install'"
      echo "          (not reproducible; commit a lockfile to the repo to fix this)"
      npm install --no-audit --no-fund
    fi
    ;;
esac

# ------------------------------------------------------------------ quality gate

if [ -f tsconfig.json ] && [ "$NO_CHECK" -eq 0 ]; then
  echo "==> Type check (npx tsc --noEmit) - skip with --no-check"
  npx tsc --noEmit
elif [ "$NO_CHECK" -eq 1 ]; then
  echo "==> Type check skipped (--no-check)"
fi

# ------------------------------------------------------------------ app metadata

APP_NAME="$REPO_NAME"
APP_VERSION="0.0.0"
if [ -f app.json ]; then
  APP_NAME="$(jq -r '.expo.slug // .expo.name // empty' app.json || true)"
  APP_VERSION="$(jq -r '.expo.version // empty' app.json || true)"
  [ -n "$APP_NAME" ]    || APP_NAME="$REPO_NAME"
  [ -n "$APP_VERSION" ] || APP_VERSION="0.0.0"
else
  echo "==> NOTE: no app.json (app.config.js/ts only?) - using repo name for the APK filename"
fi
# Keep the filename shell/URL-safe.
APP_NAME="$(printf '%s' "$APP_NAME" | tr -c 'A-Za-z0-9._-' '-')"
APP_VERSION="$(printf '%s' "$APP_VERSION" | tr -c 'A-Za-z0-9._-' '-')"

# ------------------------------------------------------------------ build

TMP_APK="$(mktemp -u "$TMP_DIR/${APP_NAME}-XXXXXXXX").apk"

echo "==> Building: eas build --platform android --profile $PROFILE --local"
echo "    (EXPO_TOKEN is set; output: $TMP_APK)"
# nice/ionice: run the whole build tree (node, gradle, javac) at low CPU and
# disk priority so live apps on this VPS always win contention. Costs the
# build a little speed only when the box is otherwise busy.
NODE_OPTIONS="--max_old_space_size=4096" \
  nice -n 10 ionice -c2 -n7 \
  eas build --platform android --profile "$PROFILE" --local --non-interactive \
  --output="$TMP_APK"

[ -s "$TMP_APK" ] || die "eas reported success but no APK was produced at $TMP_APK"

# ------------------------------------------------------------------ publish

BUILD_ID="$(openssl rand -hex 4)"
DEST_DIR="$BUILDS_DIR/$BUILD_ID"
APK_FILE="${APP_NAME}-${APP_VERSION}-$(date -u +%Y%m%d-%H%M).apk"

mkdir -p "$DEST_DIR"
mv "$TMP_APK" "$DEST_DIR/$APK_FILE"
chmod 755 "$DEST_DIR"
chmod 644 "$DEST_DIR/$APK_FILE"

# Record what this build id maps to, so `burn` (self-destruct after first
# download) knows what to delete. Stored OUTSIDE the web-served builds/ dir.
mkdir -p "$ROOT/kitchen/burn"
printf 'slug=%s\nlog=%s\n' "$REPO_SLUG" "$LOG" > "$ROOT/kitchen/burn/$BUILD_ID.meta"

APK_SIZE="$(du -h "$DEST_DIR/$APK_FILE" | cut -f1)"
URL="${BUILD_URL_BASE%/}/builds/$BUILD_ID/$APK_FILE"

# ------------------------------------------------------------------ retention
# Done BEFORE the footer so "DOWNLOAD: ..." stays the last line of the log.

# Quick pass only (APKs, logs, tmp); the weekly cron runs the full clean
# (idle repos, node_modules, gradle cache cap) via the same script.
echo "==> Retention: pruning old builds, logs and tmp"
"$ROOT/vps/clean" --after-build \
  || echo "    (cleanup warnings - run 'kitchen-clean --dry-run' to inspect)"

# ------------------------------------------------------------------ footer

printf '\n==========================================================\n'
printf '  BUILD OK   %s %s  (profile: %s, %s)\n' "$APP_NAME" "$APP_VERSION" "$PROFILE" "$SHA"
printf '  duration : %s\n' "$(elapsed)"
printf '  apk size : %s\n' "$APK_SIZE"
if [ "${BURN_AFTER_DOWNLOAD:-1}" != "0" ]; then
  printf '  burn     : link self-destructs %s min after its first download\n' \
    "${DOWNLOAD_TTL_MINUTES:-30}"
fi
printf '==========================================================\n'
printf 'DOWNLOAD: %s\n' "$URL"
